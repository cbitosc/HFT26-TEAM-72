<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Offgrid" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/blue</item>
        <item name="colorPrimaryDark">@color/blue_dark</item>
        <item name="colorAccent">@color/blue</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="materialButtonStyle">@style/Widget.Offgrid.Button</item>
    </style>

    <style name="Widget.Offgrid.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/min_touch</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="cornerRadius">@dimen/radius_btn</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
    </style>

    <style name="TextAppearance.Offgrid.Hero" parent="TextAppearance.MaterialComponents.Headline2">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="lineHeight">36sp</item>
    </style>

    <style name="TextAppearance.Offgrid.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Offgrid.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/ink2</item>
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">20sp</item>
    </style>

    <style name="TextAppearance.Offgrid.Label" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textColor">@color/mute</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <style name="TextAppearance.Offgrid.NodeId" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">monospace</item>
    </style>
</resources>
